@page "/compras/Facturas/crear"
@rendermode InteractiveServer
@inject KalanDB DB
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal
@inject IContabilidad Contabilidad
@inject ICompras Compras

<h1>Crear Factura a Proveedor</h1>
<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        <Buscador TValue="string" Etiqueta="Id Proveedor" ItemChanged="@((item)=>th_Proveedor = item)" TItem="th_proveedores" @bind-Value="cuentaspagar.proveedor_Id" SearchItems="SearchItemsProveedores" SearchExacto="SearchExactoProveedores" Llave="NombreCorto"></Buscador>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-8 col-xl-5">
        @if (th_Proveedor != null)
        {
            <ReadOnly Etiqueta="Razón Social" Value="@th_Proveedor.RazonSocial"></ReadOnly>
        }
        else
        {
            <ReadOnly Etiqueta="Razón Social" Value=" "></ReadOnly>
        }
    </div>
</div>
<div class="row">
    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-2">
        <Texto MaxLength="36" Etiqueta="Factura" @bind-Value="Factura"></Texto>
    </div>
    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-2">
        <Fecha Etiqueta="Fecha" @bind-Value="Fecha" @bind-Value:after="@(()=>InvokeAsync(StateHasChanged))"></Fecha>
    </div>
    <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-2">
        <Numerico Etiqueta="Monto de la Factura" Min="0" @bind-Value="Monto"></Numerico>
    </div>
</div>
 
<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-3">
        <Texto Etiqueta="UUID" MaxLength="36" @bind-Value="UUID"></Texto>
    </div>
    <div class="col-12 col-sm-12 col-md-6 col-lg-3 col-xl-2">
        <div class="form-floating">
            <select @bind="MetodoPago" class="form-select">
                <option value="" selected disabled>Método de Pago</option>
                @foreach (var item in kalanDB.th_metodopago)
                {
                    <option value="@item.Id">@item.Id</option>
                }
            </select>
            <label>Método de Pago</label>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <Monedas @bind-ValueFecha="Fecha"
                 @bind-ValueTipoCambio="cuentaspagar.tipocambio_Id"
                 @bind-ValueMoneda="cuentaspagar.moneda_Id">
        </Monedas>
    </div>
</div>
<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <TextoLargo MaxLength="400" rows="3" Etiqueta="Comentarios" @bind-Value="Comentario"></TextoLargo>
    </div>
</div>
 
<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-3 col-xl-2">
        <button @onclick="Guardar" class="btn btn-primary">Guardar</button>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    private th_cuentaspagar cuentaspagar { get; set; } = new();
    private th_proveedores th_Proveedor { get; set; }
    private KalanDB kalanDB
    {
        get
        {
            return new KalanDB(DB.connectionString);
        }
    }
    private DateTime Fecha { get; set; }
    private decimal Monto { get; set; }
    private string Comentario { get; set; }
    private string Factura { get; set; }
    private string UUID { get; set; }
    private string MetodoPago { get; set; }
    protected override async Task OnInitializedAsync()
    {
        Fecha = DateTime.Now.Date;
        Comentario = "";
    }
    private async Task<IEnumerable<th_proveedores>> SearchItemsProveedores(string value)
    {
        return DB.th_proveedores.Where(c => c.NombreCorto.Contains(value) || c.RazonSocial.Contains(value)).ToList().AsEnumerable();
    }
    private async Task<IEnumerable<th_proveedores>> SearchExactoProveedores(string value)
    {
        return DB.th_proveedores.Where(c => c.NombreCorto == value).ToList().AsEnumerable();
    }

    private async Task Guardar()
    {
        if (th_Proveedor == null)
        {
            await Swal.FireAsync("Error", "Debe seleccionar un proveedor", SweetAlertIcon.Error);
            return;
        }
        if (string.IsNullOrEmpty(MetodoPago))
        {
            await Swal.FireAsync("Error", "Debe seleccionar el método de pago", SweetAlertIcon.Error);
            return;
        }
        if (string.IsNullOrEmpty(Factura))
        {
            await Swal.FireAsync("Error", "Debe capturar la factura", SweetAlertIcon.Error);
            return;
        }
        if (Monto <= 0)
        {
            await Swal.FireAsync("Error", "El monto debe ser mayor a 0", SweetAlertIcon.Error);
            return;
        }
        var _authState = await authenticationStateTask;
        var user = _authState.User;
        var correo = ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        cuentaspagar.Fecha = Fecha;
        cuentaspagar.Factura = Factura;
        cuentaspagar.metodopago_Id = MetodoPago;
        cuentaspagar.UUID = UUID;
        cuentaspagar.Id = Guid.NewGuid().ToString();
        cuentaspagar.Original = Monto;
        cuentaspagar.Observaciones = Comentario;
        cuentaspagar.proveedor_Id = th_Proveedor.Id;
        cuentaspagar.UsuarioCreacion = correo;
        cuentaspagar.FechaCreacion = DateTime.Now;
        cuentaspagar.Activo = true;
        cuentaspagar.Disponible = Monto;
        await Compras.Directa(cuentaspagar);
        await Contabilidad.ComprasDirecto(cuentaspagar.Id, correo);
        await Swal.FireAsync("Guardado", $"La factura {cuentaspagar.Factura} ha sido guardada", SweetAlertIcon.Success);
        NavigationManager.NavigateTo("/Compras/Facturas/listado");
    }
}
