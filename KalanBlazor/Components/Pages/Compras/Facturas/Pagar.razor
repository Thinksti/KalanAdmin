@page "/compras/Facturas/pagar"
@using KalanBlazor.BL.Compras
@rendermode InteractiveServer
@inject KalanDB DB
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal
@inject LoadingService Spinner
<SpinnerLoading></SpinnerLoading>

<h1>Pagar Factura a Proveedor</h1>
<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        <Buscador TValue="string" Etiqueta="Id Proveedor" @bind-Value="NombreCorto" ItemChanged="@((item)=>th_Proveedor = item)" TItem="th_proveedores" SearchItems="SearchItemsProveedores" SearchExacto="SearchExactoProveedores" Llave="NombreCorto"></Buscador>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-8 col-xl-5">
        @if (th_Proveedor != null)
        {
            <ReadOnly Etiqueta="Razón Social" Value="@th_Proveedor.RazonSocial"></ReadOnly>
        }
        else
        {
            <ReadOnly Etiqueta="Razón Social" Value=" "></ReadOnly>
        }
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        <Fecha @bind-Value="Fecha" Etiqueta="Fecha de Pago"></Fecha>
    </div>
</div>
<br/>
<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        <Buscador TValue="string" Etiqueta="Egreso" @bind-Value="Egreso" ItemChanged="AsignarEgreso" TItem="ListadoPagos" SearchItems="SearchItemsEgreso" SearchExacto="SearchExactoEgreso" Llave="Documento"></Buscador>
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        @if (th_egreso != null)
        {
            <ReadOnly Etiqueta="Monto Original" Value="@th_egreso.Monto_Original.ToString("c")"></ReadOnly>
        }
        else
        {
            <ReadOnly Etiqueta="Monto Original" Value=" "></ReadOnly>
        }
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        @if (th_egreso != null)
        {
            <ReadOnly Etiqueta="Disponible" Value="@th_egreso.Monto_Disponible.ToString("c")"></ReadOnly>
        }
        else
        {
            <ReadOnly Etiqueta="Disponible" Value=" "></ReadOnly>
        }
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        @if (th_egreso != null)
        {
            <ReadOnly Etiqueta="Fecha" Value="@th_egreso.Fecha.ToString("d")"></ReadOnly>
        }
        else
        {
            <ReadOnly Etiqueta="Fecha" Value=" "></ReadOnly>
        }
    </div>
    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        <ReadOnly Etiqueta="Aplicado" Value="@TotalAplicado.ToString("c")"></ReadOnly>
    </div>

    <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
        <button @onclick="Guardar" class="btn btn-primary">Aplicar Pago</button>
    </div>
</div>
<QuickGrid Class="table small" Items="Listado.AsQueryable()">
    
    <PropertyColumn Property="@(c => c.Factura)" Title="Factura" Sortable="true" />
    <PropertyColumn Property="@(c => c.UUID)" Title="UUID" Sortable="true" />
    <PropertyColumn Property="@(c => c.Fecha)" Title="Fecha" Format="d" Sortable="true" />
    <PropertyColumn Property="@(c => c.MontoOriginal)" Title="Monto Original" Format="c" Class="centarVertical" Align="Align.Center" Sortable="true" />
    <PropertyColumn Property="@(c => c.MontoPendiente)" Title="Monto Pendiente" Format="c" Align="Align.Center" Sortable="true" />
    <TemplateColumn Title="Monto a Aplicar" Context="factura">
        @if (factura.Aplicar)
        {
            @if (factura.MontoPendiente >= TotalDisponible)
            {
                <Numerico Etiqueta="Monto a Aplicar" Max="@TotalDisponible" Min="0" @bind-Value="factura.MontoPagar"></Numerico>
            }
            else
            {
                <Numerico Etiqueta="Monto a Aplicar" Max="@factura.MontoPendiente" Min="0" @bind-Value="factura.MontoPagar"></Numerico>
            }
        }
        else
        {
            <Numerico disabled Etiqueta="Monto a Aplicar" Max="@factura.MontoPendiente" Min="0" @bind-Value="factura.MontoPagar"></Numerico>
        }
    </TemplateColumn>
    <TemplateColumn Title="Pagar" Context="factura">
        <Switch Label=" " @bind-Value="factura.Aplicar"></Switch>
    </TemplateColumn>
</QuickGrid> 
@code {
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    private th_proveedores th_Proveedor { get; set; }
    private ListadoPagos th_egreso { get; set; }
    private string Egreso { get; set; } = "";
    private string NombreCorto { get; set; }
    private DateTime Fecha { get; set; } = DateTime.Now.Date;
    private List<FacturasPagar> Listado { get; set; } = new();
    private decimal TotalAplicado
    {
        get
        {
            return Listado.Where(c => c.Aplicar).Sum(c => c.MontoPagar);        
        }
    }
    private decimal TotalDisponible
    {
        get
        {
            if (th_egreso == null)
            {
                return 0;
            }
            else
            {
                return th_egreso.Monto_Disponible - TotalAplicado;
            }

        }
    }
    private async Task<IEnumerable<th_proveedores>> SearchItemsProveedores(string value)
    {
        return DB.th_proveedores.Where(c => c.NombreCorto.Contains(value) || c.RazonSocial.Contains(value)).ToList().AsEnumerable();
    }
    private async Task<IEnumerable<th_proveedores>> SearchExactoProveedores(string value)
    {
        return DB.th_proveedores.Where(c => c.NombreCorto == value).ToList().AsEnumerable();
    }
    private async Task<IEnumerable<ListadoPagos>> SearchItemsEgreso(string value)
    {
        if (th_Proveedor == null)
        {
            if (value == string.Empty)
            {
                var t = (from x in DB.th_egresos
                        where x.Activo == true
                          && x.Disponible > 0
                         select new ListadoPagos

                             {
                                 Activo = x.Activo,
                                 Chequera = x.bancos.Chequera,
                                 Documento = $"PGO-{x.Egreso.ToString("D7")}",
                                 Fecha = x.Fecha,
                                 Id = x.Id,
                                 Monto_Disponible = x.Disponible,
                                 Monto_Original = x.Original,
                                 Proveedor = x.proveedor.NombreCorto,
                                 Usuario = x.UsuarioCreacion
                             }).Take(10).ToList().AsEnumerable();
                return t;
            }
            else
            {
                var t = (from x in DB.th_egresos
                         where x.Egreso.ToString().Contains(value)
                         && x.Activo == true
                          && x.Disponible > 0
                         select new ListadoPagos

                             {
                                 Activo = x.Activo,
                                 Chequera = x.bancos.Chequera,
                                 Documento = $"PGO-{x.Egreso.ToString("D7")}",
                                 Fecha = x.Fecha,
                                 Id = x.Id,
                                 Monto_Disponible = x.Disponible,
                                 Monto_Original = x.Original,
                                 Proveedor = x.proveedor.NombreCorto,
                                 Usuario = x.UsuarioCreacion
                             }).Take(10).ToList().AsEnumerable();
                return t;
            }


        }
        else
        {
            if (value == ".")
            {
                var t = (from x in DB.th_egresos
                         where x.proveedor_Id == th_Proveedor.Id
                         && x.Activo == true
                          && x.Disponible > 0
                         select new ListadoPagos

                             {
                                 Activo = x.Activo,
                                 Chequera = x.bancos.Chequera,
                                 Documento = $"PGO-{x.Egreso.ToString("D7")}",
                                 Fecha = x.Fecha,
                                 Id = x.Id,
                                 Monto_Disponible = x.Disponible,
                                 Monto_Original = x.Original,
                                 Proveedor = x.proveedor.NombreCorto,
                                 Usuario = x.UsuarioCreacion
                             }).Take(10).ToList().AsEnumerable();
                return t;
            }
            else
            {
                var t = (from x in DB.th_egresos
                         where x.proveedor_Id == th_Proveedor.Id
                         && x.Egreso.ToString().Contains(value)
                          && x.Disponible > 0
                         && x.Activo == true
                         select new ListadoPagos

                             {
                                 Activo = x.Activo,
                                 Chequera = x.bancos.Chequera,
                                 Documento = $"PGO-{x.Egreso.ToString("D7")}",
                                 Fecha = x.Fecha,
                                 Id = x.Id,
                                 Monto_Disponible = x.Disponible,
                                 Monto_Original = x.Original,
                                 Proveedor = x.proveedor.NombreCorto,
                                 Usuario = x.UsuarioCreacion
                             }).Take(10).ToList().AsEnumerable();
                return t;
            }
            
        }
    }
    private async Task<IEnumerable<ListadoPagos>> SearchExactoEgreso(string value)
    {
        if (th_Proveedor == null)
        {
            return DB.th_egresos.Where(c => c.Egreso.ToString() == value && c.Activo==true && c.Disponible>0).Select(x => new ListadoPagos
                {
                    Activo = x.Activo,
                    Chequera = x.bancos.Chequera,
                    Documento = $"PGO-{x.Egreso.ToString("D7")}",
                    Fecha = x.Fecha,
                    Id = x.Id,
                    Monto_Disponible = x.Disponible,
                    Monto_Original = x.Original,
                    Proveedor = x.proveedor.NombreCorto,
                    Usuario = x.UsuarioCreacion
                }).ToList().AsEnumerable();
        }
        else
        {
            return DB.th_egresos.Where(c => c.proveedor_Id == th_Proveedor.Id && c.Egreso.ToString() == value && c.Activo == true && c.Disponible > 0).Select(x => new ListadoPagos
                {
                    Activo = x.Activo,
                    Chequera = x.bancos.Chequera,
                    Documento = $"PGO-{x.Egreso.ToString("D7")}",
                    Fecha = x.Fecha,
                    Id = x.Id,
                    Monto_Disponible = x.Disponible,
                    Monto_Original = x.Original,
                    Proveedor = x.proveedor.NombreCorto,
                    Usuario = x.UsuarioCreacion
                }).ToList().AsEnumerable();
        }
    }
    private async Task AsignarEgreso(ListadoPagos egresos)
    {
        th_egreso = egresos;
        th_Proveedor = DB.th_proveedores.Where(c => c.NombreCorto == th_egreso.Proveedor && c.Activo==true).FirstOrDefault();
        if (th_Proveedor != null)
        {
            NombreCorto = th_Proveedor.NombreCorto;
            Listado = (from i in DB.th_cuentaspagar
                       where i.proveedor_Id == th_Proveedor.Id
                        && i.Disponible > 0
                       select new FacturasPagar
                           {
                               Factura = i.Factura,
                               Fecha = i.Fecha,
                               MontoOriginal = i.Original,
                               MontoPendiente = i.Disponible,
                               FacturaId = i.Id,
                               MontoPagar = 0,
                               Aplicar = false
                           }).ToList();
        }
    }
    private async Task Guardar()
    {
        var _authState = await authenticationStateTask;
        var user = _authState.User;
        var correo = ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        if (TotalAplicado > 0)
        {
            AplicarCompras aplicar = new AplicarCompras(DB);
            Spinner.IsLoading = true;
            foreach (var item in Listado.Where(x=>x.Aplicar && x.MontoPagar>0))
            {
                try
                {
                    aplicar.AplicarPago(item.FacturaId, th_egreso.Id, item.MontoPagar, Fecha, correo);
                }
                catch (Exception ex)
                {
                    Spinner.IsLoading = false;
                    await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);                    
                    return;
                }
            }
            Spinner.IsLoading = false;
        }
        NavigationManager.NavigateTo("/compras/Facturas/listado", true);
    }
}
