@page "/compras/Facturas/Ver"
@rendermode InteractiveServer
@inject KalanDB DB
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal

<h1>Factura del Proveedor</h1>
@if(entidad != null)
{
    <div class="row">
        <div class="col-12 col-sm-12 col-md-12 col-lg-4 col-xl-2">
            <ReadOnly Etiqueta="Proveedor" @bind-Value="entidad.proveedor.NombreCorto"></ReadOnly>
        </div>
        <div class="col-12 col-sm-12 col-md-12 col-lg-8 col-xl-5">
            @if (entidad.proveedor != null)
            {
                <ReadOnly Etiqueta="Razón Social" Value="@entidad.proveedor.RazonSocial"></ReadOnly>
            }
            else
            {
                <ReadOnly Etiqueta="Razón Social" Value=" "></ReadOnly>
            }
        </div>
    </div>
    
    <div class="row">
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-2">
            <Texto disabled MaxLength="36" Etiqueta="Factura" @bind-Value="entidad.Factura"></Texto>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-2">
            <Fecha disabled Etiqueta="Fecha" @bind-Value="entidad.Fecha"></Fecha>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-2">
            <Numerico disabled Etiqueta="Monto de la Factura" Min="0" @bind-Value="entidad.Original"></Numerico>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-2">
            <Numerico disabled Etiqueta="Saldo de la Factura" Min="0" @bind-Value="entidad.Disponible"></Numerico>
        </div>
    </div>
 
    <div class="row">
        <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-3">
            <Texto disabled Etiqueta="UUID" MaxLength="36" @bind-Value="entidad.UUID"></Texto>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-3 col-xl-2">
            <div class="form-floating">
                <select disabled @bind="entidad.metodopago_Id" class="form-select">
                    <option value="" selected disabled>Método de Pago</option>
                    @foreach (var item in kalanDB.th_metodopago)
                    {
                        <option value="@item.Id">@item.Id</option>
                    }
                </select>
                <label>Método de Pago</label>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-3 col-xl-2" style="align-self:center;">
            <Switch disabled Etiqueta="Activo" @bind-Value="entidad.Activo"></Switch>
        </div>
    </div>
 
    <div class="row">
        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
            <TextoLargo disabled MaxLength="400" rows="3" Etiqueta="Comentarios" @bind-Value="entidad.Observaciones"></TextoLargo>
        </div>
    </div>
 
    <div class="row">
        <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
            <ReadOnly Etiqueta="Usuario" Value="@entidad.UsuarioCreacion"></ReadOnly>
        </div>
        <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
            <ReadOnly Etiqueta="Fecha y Hora de Creación" Value="@entidad.FechaCreacion.ToString("yyyy-MM-dd HH:mm:ss")"></ReadOnly>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            @if (entidad.th_compra_factura != null)
            {
                <h2>Detalle de la Factura</h2>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Subtotal</th>
                            <th>Impuesto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in entidad.th_compra_factura.th_compra_factura_detalle)
                        {
                            <tr>
                                <td>@item.articulo.NombreCorto - @item.articulo.Descripcion</td>
                                <td>@item.Cantidad</td>
                                <td style="text-align:right;">@item.Unitario.ToString("c")</td>
                                <td style="text-align:right;">@item.SubTotal.ToString("c")</td>
                                <td style="text-align:right;">@item.Impuesto.ToString("c")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div>
        <a href="@($"/Compras/Facturas/listado")"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string Id { get; set; }
    private DateTime Fecha { get; set; }
    private decimal Monto { get; set; }
    private string Comentario { get; set; }
    private string Factura { get; set; }
    private string UUID { get; set; }
    private string MetodoPago { get; set; }
    private th_cuentaspagar entidad { get; set; }
    private KalanDB kalanDB
    {
        get
        {
            return new KalanDB(DB.connectionString);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        entidad = await DB.th_cuentaspagar.FirstOrDefaultAsync(m => m.Id == Id);

        if (entidad is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
