@page "/compras/menu"
@inject NavigationManager NavigationManager
@rendermode InteractiveServer
<h1>Modulo de Compras</h1>


<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Proveedores</h5>
                <p class="card-text">Mantenimiento de Proveedores</p>
                <a href="/th_proveedores" class="btn btn-primary">Ir a Proveedores</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Tesorería</h5>
                <p class="card-text">Egresos</p>
                <button @onclick="@(()=>Navegar("/egresos/crear"))" class="btn btn-primary">Nuevo Pago</button>
                <button @onclick="@(()=>Navegar("/egresos/Listado"))"  class="btn btn-primary">Listado de Pagos</button>
                <button @onclick="@(()=>Navegar("/compras/Facturas/crear"))" class="btn btn-primary">Registrar Cuenta por Pagar</button>
                <button @onclick="@(()=>Navegar("/compras/Facturas/listado"))" class="btn btn-primary">Listado de Factura</button>
                <button @onclick="@(()=>Navegar("/compras/Facturas/pagar"))" class="btn btn-primary">Aplicar pago a factura</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Compras</h5>
                <button @onclick="@(()=>Navegar("/compras/facturas/comprarfactura"))" class="btn btn-primary">Registrar Factura</button>
                
            </div>
        </div>
    </div>
</div>
@code {
    private void Navegar(string url)
    {
        NavigationManager.NavigateTo(url, true);
    }
}
