                <a href="/financiero/cuentas/listado"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
            </div>
        </div>
 
</Contenido>

@code {
    [Parameter][SupplyParameterFromQuery] public string id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    private th_contabilidad_cuenta item { get; set; } = new();
    private th_contabilidad_cuenta_configuracion itemConfig { get; set; }
    protected override async Task OnInitializedAsync()
    {
        itemConfig = DB.th_contabilidad_cuenta_configuracion.FirstOrDefault();
        item = DB.th_contabilidad_cuenta.Where(m => m.Id == id).Include(x => x.categoria).FirstOrDefault();
        if (item is null)
        {
            NavigationManager.NavigateTo("/financiero/cuentas/listado");
        }
    }
    private string Usuario
    {
        get
        {
            var _authState = authenticationStateTask.Result;
            var user = _authState.User;
            return ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        }
    }
    private async Task Guardar()
    {
        try
        {
            DB.th_contabilidad_cuenta.Remove(item);
            await DB.SaveChangesAsync();
            NavigationManager.NavigateTo("/financiero/cuentas/listado");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }        
    }
}
