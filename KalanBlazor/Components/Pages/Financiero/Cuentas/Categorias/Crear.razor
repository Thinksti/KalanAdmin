@page "/financiero/cuentas/categorias/crear"

@rendermode InteractiveServer
@inject KalanDB DB
@inject Excel Excel
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal
@inject LoadingService Spinner
<SpinnerLoading></SpinnerLoading>

<Contenido Titulo="Crear un nueva Categoría">
    
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-4">
                <Texto MaxLength="50" Etiqueta="Nombre del la Categoría" @bind-Value="item.Categoria"></Texto>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
                <Texto MaxLength="255" Etiqueta="Descripción del la Categoría" @bind-Value="item.Descripcion"></Texto>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
                <Texto MaxLength="50" Etiqueta="Segmento" @bind-Value="item.Segmento"></Texto>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
                <Entero Max="1000" Min="0" Etiqueta="Agrupador SAT" @bind-Value="item.AgrupadorSAT"></Entero>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <Switch Etiqueta="Categoría Activa" @bind-Value="item.Activo"></Switch>
            </div>
        </div>
  
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <button @onclick="Guardar" class="btn btn-primary">Guardar Categoría</button>
            </div>
        </div>
     
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <a href="/financiero/cuentas/categorias/listado"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
            </div>
        </div>
 
</Contenido>

@code {
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    private th_contabilidad_cuenta_categoria item { get; set; } = new();
    private string Usuario
    {
        get
        {
            var _authState = authenticationStateTask.Result;
            var user = _authState.User;
            return ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        }
    }
    private async Task Guardar()
    {
        if (string.IsNullOrEmpty(item.Categoria))
        {
            await Swal.FireAsync("Error", "El nombre del la Categoría es requerido", SweetAlertIcon.Error);
            return;
        }
        if (string.IsNullOrEmpty(item.Descripcion))
        {
            await Swal.FireAsync("Error", "La descripción de la Categoría es requerida", SweetAlertIcon.Error);
            return;
        }
        try
        {
            item.Id = Guid.NewGuid().ToString();
            item.FechaCreacion = DateTime.Now;
            item.UsuarioCreacion = Usuario;
            await DB.th_contabilidad_cuenta_categoria.AddAsync(item);
            await DB.SaveChangesAsync();
            NavigationManager.NavigateTo("/financiero/cuentas/categorias/listado");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
            throw;
        }        
    }
}
