@page "/financiero/cuentas/editar"

@rendermode InteractiveServer
@inject KalanDB DB
@inject Excel Excel
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal
@inject LoadingService Spinner
<SpinnerLoading></SpinnerLoading>

<Contenido Titulo="Editar Cuenta Contable">
 
        <div class="row">
            @if (itemConfig.Segmento1)
            {
                <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                    @if (this.itemConfig.Costos == 1)
                    {
                        <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento1Largo" Etiqueta="Segmento Costos" @bind-Value="item.Segmento1"></Texto>
                    }
                    else
                    {
                        @if (this.itemConfig.Detalle == 1)
                        {
                            <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento1Largo" Etiqueta="Segmento Detalle" @bind-Value="item.Segmento1"></Texto>
                        }
                        else
                        {
                            @if (this.itemConfig.Mayor == 1)
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento1Largo" Etiqueta="Segmento Mayor" @bind-Value="item.Segmento1"></Texto>
                            }
                            else
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento1Largo" Etiqueta="Segmento 1" @bind-Value="item.Segmento1"></Texto>
                            }
                        }
                    }
                </div>
            }
            @if (itemConfig.Segmento2)
            {
                <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                    @if (this.itemConfig.Costos == 2)
                    {
                        <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento2Largo" Etiqueta="Segmento Costos" @bind-Value="item.Segmento2"></Texto>
                    }
                    else
                    {
                        @if (this.itemConfig.Detalle == 2)
                        {
                            <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento2Largo" Etiqueta="Segmento Detalle" @bind-Value="item.Segmento2"></Texto>
                        }
                        else
                        {
                            @if (this.itemConfig.Mayor == 2)
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento2Largo" Etiqueta="Segmento Mayor" @bind-Value="item.Segmento2"></Texto>
                            }
                            else
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento2Largo" Etiqueta="Segmento 2" @bind-Value="item.Segmento2"></Texto>
                            }
                        }
                    }
                </div>
            }
            @if (itemConfig.Segmento3)
            {
                <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                    @if (this.itemConfig.Costos == 3)
                    {
                        <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento3Largo" Etiqueta="Segmento Costos" @bind-Value="item.Segmento3"></Texto>
                    }
                    else
                    {
                        @if (this.itemConfig.Detalle == 3)
                        {
                            <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento3Largo" Etiqueta="Segmento Detalle" @bind-Value="item.Segmento3"></Texto>
                        }
                        else
                        {
                            @if (this.itemConfig.Mayor == 3)
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento3Largo" Etiqueta="Segmento Mayor" @bind-Value="item.Segmento3"></Texto>
                            }
                            else
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento3Largo" Etiqueta="Segmento 3" @bind-Value="item.Segmento3"></Texto>
                            }
                        }
                    }
                </div>
            }
            @if (itemConfig.Segmento4)
            {
                <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                    @if (this.itemConfig.Costos == 4)
                    {
                        <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento4Largo" Etiqueta="Segmento Costos" @bind-Value="item.Segmento4"></Texto>
                    }
                    else
                    {
                        @if (this.itemConfig.Detalle == 4)
                        {
                            <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento4Largo" Etiqueta="Segmento Detalle" @bind-Value="item.Segmento4"></Texto>
                        }
                        else
                        {
                            @if (this.itemConfig.Mayor == 4)
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento4Largo" Etiqueta="Segmento Mayor" @bind-Value="item.Segmento4"></Texto>
                            }
                            else
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento4Largo" Etiqueta="Segmento 4" @bind-Value="item.Segmento4"></Texto>
                            }
                        }
                    }
                </div>
            }
            @if (itemConfig.Segmento5)
            {
                <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                    @if (this.itemConfig.Costos == 5)
                    {
                        <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento5Largo" Etiqueta="Segmento Costos" @bind-Value="item.Segmento5"></Texto>
                    }
                    else
                    {
                        @if (this.itemConfig.Detalle == 5)
                        {
                            <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento5Largo" Etiqueta="Segmento Detalle" @bind-Value="item.Segmento5"></Texto>
                        }
                        else
                        {
                            @if (this.itemConfig.Mayor == 5)
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento5Largo" Etiqueta="Segmento Mayor" @bind-Value="item.Segmento5"></Texto>
                            }
                            else
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento5Largo" Etiqueta="Segmento 5" @bind-Value="item.Segmento5"></Texto>
                            }
                        }
                    }
                </div>
            }
            @if (itemConfig.Segmento6)
            {
                <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                    @if (this.itemConfig.Costos == 6)
                    {
                        <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento6Largo" Etiqueta="Segmento Costos" @bind-Value="item.Segmento6"></Texto>
                    }
                    else
                    {
                        @if (this.itemConfig.Detalle == 6)
                        {
                            <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento6Largo" Etiqueta="Segmento Detalle" @bind-Value="item.Segmento6"></Texto>
                        }
                        else
                        {
                            @if (this.itemConfig.Mayor == 6)
                            {
                                <Texto EsBuscador="true" MaxLength="@itemConfig.Segmento6Largo" Etiqueta="Segmento Mayor" @bind-Value="item.Segmento6"></Texto>
