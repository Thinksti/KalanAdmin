                </div>
            }
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <ReadOnly Etiqueta="Cuenta Contable" Value="@CuentaContable"></ReadOnly>
            </div>
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <Combo Etiqueta="Categoría Contable" TItem="th_contabilidad_cuenta_categoria" TextValue="Categoria" ItemValue="Id" Items="Categorias" ItemChanged="CambiarCategoria" TValue="string" @bind-Value="item.categoria_id"></Combo>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
                <Texto MaxLength="150" Etiqueta="Descripción la Cuenta Contable" @bind-Value="item.Descripcion"></Texto>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <Switch Etiqueta="Cuenta Activa" @bind-Value="item.Activo"></Switch>
            </div>
        </div>
     
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <button @onclick="Guardar" class="btn btn-primary">Actualizar Cuenta</button>
            </div>
        </div>
       
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <a href="/financiero/cuentas/listado"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
            </div>
        </div>
  
</Contenido>

@code {
    [Parameter] [SupplyParameterFromQuery] public string id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    private th_contabilidad_cuenta item { get; set; } = new();
    private List<th_contabilidad_cuenta_categoria> Categorias { get; set; }
    private th_contabilidad_cuenta_configuracion itemConfig { get; set; }
    private string CuentaContable
    {
        get
        {
            var cc = "";
            if (itemConfig.Segmento1)
            {
                cc += $"{item.Segmento1}";
            }
            if (itemConfig.Segmento2)
            {
                cc += $"-{item.Segmento2}";
            }
            if (itemConfig.Segmento3)
            {
                cc += $"-{item.Segmento3}";
            }
            if (itemConfig.Segmento4)
            {
                cc += $"-{item.Segmento4}";
            }
            if (itemConfig.Segmento5)
            {
                cc += $"-{item.Segmento5}";
            }
            if (itemConfig.Segmento6)
            {
                cc += $"-{item.Segmento6}";
            }
            return cc;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        itemConfig = DB.th_contabilidad_cuenta_configuracion.FirstOrDefault();
        Categorias = DB.th_contabilidad_cuenta_categoria.OrderBy(x => x.Categoria).ToList();
        item = await DB.th_contabilidad_cuenta.FirstOrDefaultAsync(m => m.Id == id);        
        if (item is null)
        {
            NavigationManager.NavigateTo("/financiero/cuentas/listado");
        }
    }
    private string Usuario
    {
        get
        {
            var _authState = authenticationStateTask.Result;
            var user = _authState.User;
            return ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        }
    }
    public bool TodosCaracteresSonNumeros(string input)
    {
        return input.All(char.IsDigit);
    }
    private async Task CambiarCategoria(th_contabilidad_cuenta_categoria categoria)
    {
        switch (itemConfig.Mayor)
        {
            case 1:
                item.Segmento1 = categoria.Segmento;
                break;
            case 2:
                item.Segmento2 = categoria.Segmento;
                break;
            case 3:
                item.Segmento3 = categoria.Segmento;
                break;
            case 4:
                item.Segmento4 = categoria.Segmento;
                break;
            case 5:
                item.Segmento5 = categoria.Segmento;
                break;
            case 6:
                item.Segmento6 = categoria.Segmento;
                break;
            default:
                break;
        }

    }
    private async Task Guardar()
    {
        if (CuentaContable.Contains("--") || CuentaContable.StartsWith("--") || CuentaContable.EndsWith("--"))
        {
            await Swal.FireAsync("Error", "Cuenta Contable invalida", SweetAlertIcon.Error);
            return;
        }
        if (TodosCaracteresSonNumeros(CuentaContable.Replace("-", "")) == false)
        {
            await Swal.FireAsync("Error", "Cuenta Contable invalida solo Números", SweetAlertIcon.Error);
            return;
        }
        if (string.IsNullOrEmpty(item.Descripcion))
        {
            await Swal.FireAsync("Error", "La descripción del impuesto es requerida", SweetAlertIcon.Error);
            return;
        }
        try
        {
            item.CuentaContable = this.CuentaContable;
            item.FechaModifica = DateTime.Now;
            item.UsuarioModifica = Usuario;
            DB.th_contabilidad_cuenta.Update(item);
            await DB.SaveChangesAsync();
            NavigationManager.NavigateTo("/financiero/cuentas/listado");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
            throw;
        }
    }
 
}
