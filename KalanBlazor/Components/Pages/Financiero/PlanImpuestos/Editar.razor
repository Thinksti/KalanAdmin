@page "/financiero/planimpuestos/editar"

@rendermode InteractiveServer
@inject KalanDB DB
@inject Excel Excel
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal
@inject LoadingService Spinner
<SpinnerLoading></SpinnerLoading>

<Contenido Titulo="Editar Plan de Impuesto">
  
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-4">
                <Texto MaxLength="15" disabled Etiqueta="Nombre del Plan de Impuesto" @bind-Value="item.NombreCorto"></Texto>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
                <Texto MaxLength="100" Etiqueta="Descripción del Plan de Impuesto" @bind-Value="item.Descripcion"></Texto>
            </div>
        </div> 
        
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <Switch Etiqueta="Impuesto Activo" @bind-Value="item.Activo"></Switch>
            </div>
        </div>
  
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <Switch Etiqueta="Impuesto para Ventas" @bind-Value="item.Ventas"></Switch>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <Switch Etiqueta="Impuesto para Compras" @bind-Value="item.Compras"></Switch>
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Impuesto</th>
                            <th>Descripción</th>
                            <th>Porcentaje</th>
                            <th>Impuesto Activo</th>
                            <th></th>
                        </tr
                    </thead>
                    <tbody>
                        @foreach (var impuesto in impuestos)
                        {
                            <tr>
                                <td>@impuesto.NombreCorto</td>
                                <td>@impuesto.Descripcion</td>
                                <td>@impuesto.Porcentaje</td>
                                <td style="align-self:center;">
                                    <Switch Etiqueta=" " disabled @bind-Value="impuesto.Activo"></Switch>
                                </td>
                                <td style="align-self:center;">
                                    @if (impuesto.Activo)
                                    {
                                        <Switch Etiqueta="Agregar al Plan de Impuestos" Value="@(Asignado(impuesto.Id))"  ValueChanged="@(()=>Asignar(impuesto.Id))"></Switch>
                                    }
                                    else
                                    {
                                        <Switch Etiqueta="Agregar al Plan de Impuestos" Value="@(Asignado(impuesto.Id))" disabled  ValueChanged="@(()=>Asignar(impuesto.Id))"></Switch>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <button @onclick="Guardar" class="btn btn-primary">Actualizar Impuesto</button>
            </div>
        </div>
        </div>
        
        <div class="row">
            <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
                <a href="/financiero/planimpuestos/listado"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
            </div>
        </div>
 
</Contenido>

@code {
    [Parameter][SupplyParameterFromQuery] public string id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    private th_plan_impuestos item { get; set; } = new();
    private List<th_impuestos> impuestos { get; set; }
    private List<string> impuestosSeleccionados { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        item = DB.th_plan_impuestos
        .Where(x => x.Id == id)
        .Include(x => x.th_plan_impuestos_detalle)
        .ThenInclude(x => x.impuestos)
        .IgnoreAutoIncludes()
        .FirstOrDefault();
        if (item is null)
        {
            NavigationManager.NavigateTo("/financiero/planimpuestos/listado");
        }
        impuestos = DB.th_impuestos.IgnoreAutoIncludes().ToList();
        foreach (var titem in item.th_plan_impuestos_detalle)
        {
            if (titem.Activo)
            {
                await Asignar(titem.impuestos_id);
            }
        }
    }
    private bool Asignado(string id_impuesto)
    {
        return impuestosSeleccionados.Contains(id_impuesto);
    }
    private async Task Asignar(string id_impuesto)
    {
        if (impuestosSeleccionados.Contains(id_impuesto))
        {
            impuestosSeleccionados.Remove(id_impuesto);
        }
        else
        {
            impuestosSeleccionados.Add(id_impuesto);
        }
    }
    private string Usuario
    {
        get
        {
            var _authState = authenticationStateTask.Result;
            var user = _authState.User;
            return ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        }
    }
    private async Task Guardar()
    {
        if (string.IsNullOrEmpty(item.NombreCorto))
        {
            await Swal.FireAsync("Error", "El nombre del impuesto es requerido", SweetAlertIcon.Error);
            return;
        }
        if (string.IsNullOrEmpty(item.Descripcion))
        {
            await Swal.FireAsync("Error", "La descripción del plan de impuesto es requerida", SweetAlertIcon.Error);
            return;
        }
        try
        {
            item.FechaModifica = DateTime.Now;
            item.UsuarioModifica = Usuario;
            DB.th_plan_impuestos.Update(item);
            await DB.SaveChangesAsync();
            foreach (var titem in impuestosSeleccionados)
            {
                if( item.th_plan_impuestos_detalle.Where(x=>x.impuestos_id == titem).Count() > 0)
                {
                    var impuesto = item.th_plan_impuestos_detalle.Where(x => x.impuestos_id == titem).FirstOrDefault();
                    impuesto.Activo = true;
                    impuesto.FechaModifica = DateTime.Now;
                    impuesto.UsuarioModifica = Usuario;
                    DB.th_plan_impuestos_detalle.Update(impuesto);
                    DB.SaveChanges();
                }
                else
                {
                    var impuesto = new th_plan_impuestos_detalle();
                    impuesto.Id = Guid.NewGuid().ToString();
                    impuesto.impuestos_id = titem;
                    impuesto.plan_impuestos_id = item.Id;
                    impuesto.Activo = true;
                    impuesto.FechaCreacion = DateTime.Now;
                    impuesto.UsuarioCreacion = Usuario;
                    DB.th_plan_impuestos_detalle.Add(impuesto);
                    DB.SaveChanges();
                }
            }
            NavigationManager.NavigateTo("/financiero/planimpuestos/listado");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
            throw;
        }
    }

}
