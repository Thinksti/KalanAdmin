@page "/th_bancos/create"
@rendermode InteractiveServer
@inject KalanDB DB
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal

<PageTitle>Create</PageTitle>
<Contenido Titulo="Crear Banco">
   

<h1>Crear</h1>

<h4>Nueva Chequera</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @if (th_bancos != null)
        {
            <EditForm Model="th_bancos" OnValidSubmit="Addth_bancos" FormName="create">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label for="chequera" class="form-label">Chequera:</label>
                    <InputText id="chequera" @bind-Value="th_bancos.Chequera" class="form-control" />
                    <ValidationMessage For="() => th_bancos.Chequera" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="CajaChica" class="form-label">Es Caja Chica:</label>
                    @if (string.IsNullOrEmpty(th_bancos.Banco))
                    {
                        <InputCheckbox id="CajaChica" @bind-Value="th_bancos.CajaChica" @bind-Value:after="EsCajaChica" class="form-check-input" />
                    }
                    else
                    {
                        @if (th_bancos.Banco == "Caja Chica")
                        {
                            <InputCheckbox disabled id="CajaChica" @bind-Value="th_bancos.CajaChica" @bind-Value:after="EsCajaChica" class="form-check-input" />
                        }
                        else
                        {
                            <InputCheckbox id="CajaChica" @bind-Value="th_bancos.CajaChica" @bind-Value:after="EsCajaChica" class="form-check-input" />
                        }
                    }

                    <ValidationMessage For="() => th_bancos.CajaChica" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="banco" class="form-label">Banco:</label>
                    <InputText id="banco" @bind-Value="th_bancos.Banco" class="form-control" />
                    <ValidationMessage For="() => th_bancos.Banco" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="cuenta" class="form-label">Cuenta:</label>
                    <InputText id="cuenta" @bind-Value="th_bancos.Cuenta" class="form-control" />
                    <ValidationMessage For="() => th_bancos.Cuenta" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="saldo" class="form-label">Saldo:</label>
                    <InputNumber id="saldo" @bind-Value="th_bancos.Saldo" class="form-control" />
                    <ValidationMessage For="() => th_bancos.Saldo" class="text-danger" />
                </div>

                <div class="mb-3">
                    <CuentaContable Etiqueta="Cuenta Contable del Banco" @bind-Value="th_bancos.cuentacontable_id"></CuentaContable>
                </div>

                <div class="mb-3">
                    <Combo Etiqueta="Moneda" 
                           TItem="th_monedas"
                           Items="@MonedasList"
                           TValue="string"
                           ItemValue="Id"
                           TextValue="NombreCorto"
                           @bind-Value="th_bancos.moneda_Id">
                    </Combo>
                </div>

                <div class="mb-3">
                    <div class="mb-3">
                        <label for="activo" class="form-label">Activo:</label>
                        <InputCheckbox id="activo" @bind-Value="th_bancos.Activo" class="form-check-input" />
                        <ValidationMessage For="() => th_bancos.Activo" class="text-danger" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        }
        
    </div>
</div>

<div>
    <a href="/th_bancos"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
</div>
</Contenido>
@code {
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    [SupplyParameterFromForm]
    public th_bancos th_bancos { get; set; } = new th_bancos();
    private List<th_monedas> MonedasList { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {            
            MonedasList = await DB.th_monedas.ToListAsync();             
            StateHasChanged();
        }
    }

    private async Task EsCajaChica()
    {
        if (th_bancos.CajaChica)
        {
            th_bancos.Banco = "Caja Chica";
            th_bancos.Cuenta = th_bancos.Chequera;
        }
        
    }
    public async Task Addth_bancos()
    {
        var _authState = await authenticationStateTask;
        var user = _authState.User;
        var correo = ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        th_bancos.UsuarioCreacion = correo;
        th_bancos.Id=Guid.NewGuid().ToString();
        th_bancos.FechaCreacion = DateTime.Now;    
        th_bancos.FechaUltimaConciliacion = DateTime.Now;
        th_bancos.SaldoUltimaConciliacion = th_bancos.Saldo;
        if (th_bancos.CajaChica)
        {
            th_bancos.Banco = "Caja Chica";
            th_bancos.Cuenta = th_bancos.Chequera;
        }
        DB.th_bancos.Add(th_bancos);
        await DB.SaveChangesAsync();
        NavigationManager.NavigateTo("/th_bancos");
    }
}
