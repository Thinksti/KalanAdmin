@page "/th_bancos/delete"
@inject KalanDB DB
@inject KalanDB DB
@inject SweetAlertService Swal
@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
<PageTitle>Delete</PageTitle>

<h1>Borrar registro</h1>

<h3>¿Estas seguro de borrar el registro?</h3>
<div>
    <h4>Chequera</h4>
    <hr />
    @if (th_bancos is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Chequera</dt>
            <dd class="col-sm-10">@th_bancos.Chequera</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Banco</dt>
            <dd class="col-sm-10">@th_bancos.Banco</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Cuenta</dt>
            <dd class="col-sm-10">@th_bancos.Cuenta</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Saldo</dt>
            <dd class="col-sm-10">@th_bancos.Saldo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Activo</dt>
            <dd class="col-sm-10">@th_bancos.Activo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UsuarioCreacion</dt>
            <dd class="col-sm-10">@th_bancos.UsuarioCreacion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaCreacion</dt>
            <dd class="col-sm-10">@th_bancos.FechaCreacion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UsuarioModifica</dt>
            <dd class="col-sm-10">@th_bancos.UsuarioModifica</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaModifica</dt>
            <dd class="col-sm-10">@th_bancos.FechaModifica</dd>
        </dl>
        <EditForm method="post" Model="th_bancos" OnValidSubmit="Deleteth_bancos" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(th_bancos is null)">Borrar</button> |
            <a href="/th_bancos"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
        </EditForm>
    }
</div>

@code {
    th_bancos? th_bancos;

    [SupplyParameterFromQuery]
    public string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        th_bancos = await DB.th_bancos.FirstOrDefaultAsync(m => m.Id == Id);

        if (th_bancos is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async Task Deleteth_bancos()
    {
        try
        {
            DB.th_bancos.Remove(th_bancos!);
            await DB.SaveChangesAsync();
            NavigationManager.NavigateTo("/th_bancos");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Imposible borrar la chequera", SweetAlertIcon.Error);
        }
     
    }
}
