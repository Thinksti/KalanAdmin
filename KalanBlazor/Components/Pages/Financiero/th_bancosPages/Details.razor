@page "/th_bancos/details"
@inject KalanDB DB

@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
<PageTitle>Details</PageTitle>

<h1>Detalles</h1>

<div>
    <h4>Chequera</h4>
    <hr />
    @if (th_bancos is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Chequera</dt>
            <dd class="col-sm-10">@th_bancos.Chequera</dd>
            <dt class="col-sm-2">Banco</dt>
            <dd class="col-sm-10">@th_bancos.Banco</dd>
            <dt class="col-sm-2">Cuenta</dt>
            <dd class="col-sm-10">@th_bancos.Cuenta</dd>
            <dt class="col-sm-2">Saldo</dt>
            <dd class="col-sm-10">@th_bancos.Saldo</dd>
            <dt class="col-sm-2">Activo</dt>
            <dd class="col-sm-10">@th_bancos.Activo</dd>

            <dt class="col-sm-2">Saldo Ultima Conciliación</dt>
            <dd class="col-sm-10">@th_bancos.SaldoUltimaConciliacion</dd>

            <dt class="col-sm-2">Fecha Ultima Conciliación</dt>
            <dd class="col-sm-10">@th_bancos.FechaUltimaConciliacion</dd>

            <dt class="col-sm-2">UsuarioCreacion</dt>
            <dd class="col-sm-10">@th_bancos.UsuarioCreacion</dd>
            <dt class="col-sm-2">FechaCreacion</dt>
            <dd class="col-sm-10">@th_bancos.FechaCreacion</dd>
            <dt class="col-sm-2">UsuarioModifica</dt>
            <dd class="col-sm-10">@th_bancos.UsuarioModifica</dd>
            <dt class="col-sm-2">FechaModifica</dt>
            <dd class="col-sm-10">@th_bancos.FechaModifica</dd>
        </dl>
        <div>
            <a href="@($"/th_bancos/edit?id={th_bancos.Id}")"><i class="fa-solid fa-pen-to-square"></i> Editar</a> |
            <a href="@($"/th_bancos")"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
        </div>
    }
</div>

@code {
    th_bancos? th_bancos;

    [SupplyParameterFromQuery]
    public string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        th_bancos = await DB.th_bancos.FirstOrDefaultAsync(m => m.Id == Id);

        if (th_bancos is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
