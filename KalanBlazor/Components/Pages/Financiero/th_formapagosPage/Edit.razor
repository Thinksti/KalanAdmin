@page "/th_formapagos/edit"
@inject KalanDB DB
@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore

<PageTitle>Edit</PageTitle>

<h1>Editar</h1>

<h4>Forma de Pago</h4>
<hr />
@if (entidad is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="entidad" OnValidSubmit="accion" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="mb-3">
                    <label for="Id" class="form-label">Id Forma de Pago:</label>
                    <InputText id="Id" @bind-Value="entidad.Id" class="form-control" />
                    <ValidationMessage For="() => entidad.Id" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="FormaPago" class="form-label">Forma de Pago:</label>
                    <InputText id="FormaPago" @bind-Value="entidad.FormaPago" class="form-control" />
                    <ValidationMessage For="() => entidad.FormaPago" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="activo" class="form-label">Activo:</label>
                    <InputCheckbox id="activo" @bind-Value="entidad.Activo" class="form-check-input" />
                    <ValidationMessage For="() => entidad.Activo" class="text-danger" />
                </div>
                <div class="mb-3 Ocultar">
                    <label for="usuariocreacion" class="form-label">UsuarioCreacion:</label>
                    <InputText id="usuariocreacion" @bind-Value="entidad.UsuarioCreacion" class="form-control" />
                    <ValidationMessage For="() => entidad.UsuarioCreacion" class="text-danger" />
                </div>
                <div class="mb-3 Ocultar">
                    <label for="fechacreacion" class="form-label">FechaCreacion:</label>
                    <InputDate id="fechacreacion" @bind-Value="entidad.FechaCreacion" class="form-control" />
                    <ValidationMessage For="() => entidad.FechaCreacion" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>
}


<div>
    <a href="/th_formapagos"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
</div>
@code {
    [SupplyParameterFromQuery]
    public string Id { get; set; }
    [SupplyParameterFromForm]
    public th_formapago? entidad { get; set; } = new();
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    protected override async Task OnInitializedAsync()
    {
        entidad = await DB.th_formapago.FirstOrDefaultAsync(m => m.Id == Id);

        if (entidad is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
        entidad.FechaModifica = DateTime.Now;
    }
    private KalanDB kalanDB
    {
        get
        {
            return new KalanDB(DB.connectionString);
        }
    }
    public async Task accion()
    {
        entidad.Id = Guid.NewGuid().ToString();
        var _authState = await authenticationStateTask;
        var user = _authState.User;
        var correo = ((System.Security.Claims.ClaimsIdentity)user.Identity).Name;
        entidad.FechaModifica = DateTime.Now;
        entidad.UsuarioModifica = correo;
        DB.Attach(entidad!).State = EntityState.Modified;
        try
        {
            await DB.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!Exists(entidad!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }
         
        NavigationManager.NavigateTo("/th_formapagos");
    }

    bool Exists(string id)
    {
        return DB.th_condicionescredito.Any(e => e.Id == id);
    }
}
