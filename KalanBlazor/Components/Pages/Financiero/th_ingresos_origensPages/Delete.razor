@page "/th_origenes/delete"
@inject KalanDB DB;
@inject SweetAlertService Swal;
@inject NavigationManager NavigationManager ;
@rendermode InteractiveServer ;


<PageTitle>Delete</PageTitle>

<h1>Borrar registro</h1>

<h3>¿Estas seguro de borrar el registro?</h3>
<div>
    <h4>Origen de Ingreso</h4>
    <hr />
    @if (entidad is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Origen</dt>
            <dd class="col-sm-10">@entidad.Origen</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Observaciones</dt>
            <dd class="col-sm-10">@entidad.Observaciones</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Activo</dt>
            <dd class="col-sm-10">@entidad.Activo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UsuarioCreacion</dt>
            <dd class="col-sm-10">@entidad.UsuarioCreacion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaCreacion</dt>
            <dd class="col-sm-10">@entidad.FechaCreacion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UsuarioModifica</dt>
            <dd class="col-sm-10">@entidad.UsuarioModifica</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaModifica</dt>
            <dd class="col-sm-10">@entidad.FechaModifica</dd>
        </dl>
        <EditForm method="post" Model="entidad" OnValidSubmit="Deleteth" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(entidad is null)">Borrar</button> |
            <a href="/th_origenes"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
        </EditForm>
    }
</div>

@code {
    th_ingresos_origen? entidad;

    [SupplyParameterFromQuery]
    public string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        entidad = await DB.th_ingresos_origen.FirstOrDefaultAsync(m => m.Id == Id);

        if (entidad is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async Task Deleteth()
    {
        try
        {
            DB.th_ingresos_origen.Remove(entidad!);
            await DB.SaveChangesAsync();
            NavigationManager.NavigateTo("/th_origenes");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Imposible borrar los términos de crédito", SweetAlertIcon.Error);
        }

    }
}
