@page "/th_regimenfiscals/delete"
@inject KalanDB DB
@inject SweetAlertService Swal
@inject NavigationManager NavigationManager 
@rendermode InteractiveServer 


<PageTitle>Delete</PageTitle>

<h1>Borrar registro</h1>

<h3>¿Estas seguro de borrar el registro?</h3>
<div>
    <h4>Regimen Fiscal</h4>
    <hr />
    @if (th_regimenfiscal is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Regimen</dt>
            <dd class="col-sm-10">@th_regimenfiscal.Regimen</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Activo</dt>
            <dd class="col-sm-10">@th_regimenfiscal.Activo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UsuarioCreacion</dt>
            <dd class="col-sm-10">@th_regimenfiscal.UsuarioCreacion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaCreacion</dt>
            <dd class="col-sm-10">@th_regimenfiscal.FechaCreacion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UsuarioModifica</dt>
            <dd class="col-sm-10">@th_regimenfiscal.UsuarioModifica</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaModifica</dt>
            <dd class="col-sm-10">@th_regimenfiscal.FechaModifica</dd>
        </dl>
        <EditForm method="post" Model="th_regimenfiscal" OnValidSubmit="Deleteth_regimenfiscal" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(th_regimenfiscal is null)">Borrar</button> |
            <a href="/th_regimenfiscals"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
        </EditForm>
    }
</div>

@code {
    th_regimenfiscal? th_regimenfiscal;

    [SupplyParameterFromQuery]
    public string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        th_regimenfiscal = await DB.th_regimenfiscal.FirstOrDefaultAsync(m => m.Id == Id);

        if (th_regimenfiscal is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    public async Task Deleteth_regimenfiscal()
    {
        try
        {
            DB.th_regimenfiscal.Remove(th_regimenfiscal!);
            await DB.SaveChangesAsync();
            NavigationManager.NavigateTo("/th_regimenfiscals");
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error", "Imposible borrar el régimen fiscal", SweetAlertIcon.Error);
        }
        
    }
}
