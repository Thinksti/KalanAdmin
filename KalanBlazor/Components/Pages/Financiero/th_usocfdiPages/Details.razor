@page "/th_usocfdis/details"
@inject KalanDB DB

@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore

<PageTitle>Details</PageTitle>

<h1>Detalles</h1>

<div>
    <h4>th_usocfdi</h4>
    <hr />
    @if (th_usocfdi is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">UsoCFDi</dt>
            <dd class="col-sm-10">@th_usocfdi.UsoCFDi</dd>
            <dt class="col-sm-2">Activo</dt>
            <dd class="col-sm-10">@th_usocfdi.Activo</dd>
            <dt class="col-sm-2">UsuarioCreacion</dt>
            <dd class="col-sm-10">@th_usocfdi.UsuarioCreacion</dd>
            <dt class="col-sm-2">FechaCreacion</dt>
            <dd class="col-sm-10">@th_usocfdi.FechaCreacion</dd>
            <dt class="col-sm-2">UsuarioModifica</dt>
            <dd class="col-sm-10">@th_usocfdi.UsuarioModifica</dd>
            <dt class="col-sm-2">FechaModifica</dt>
            <dd class="col-sm-10">@th_usocfdi.FechaModifica</dd>
        </dl>
        <div>
            <a href="@($"/th_usocfdis/edit?id={th_usocfdi.Id}")"><i class="fa-solid fa-pen-to-square"></i> Editar</a> |
            <a href="@($"/th_usocfdis")"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
        </div>
    }
</div>

@code {
    th_usocfdi? th_usocfdi;

    [SupplyParameterFromQuery]
    public string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        th_usocfdi = await DB.th_usocfdi.FirstOrDefaultAsync(m => m.Id == Id);

        if (th_usocfdi is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
