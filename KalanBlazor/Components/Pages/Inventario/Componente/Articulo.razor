<div class="card">
    <div class="card-body">
        <h5 class="card-title">@item.NombreCorto</h5>
        <div class="row">
            <div class="col-12">
                @if(item.OpImpCompra == 1)
                {
                    <span>Sin Impuestos</span>
                }
                else
                {
                    @if (item.OpImpCompra == 2)
                    {
                        <span>Los impuestos dependen del proveedor</span>
                    }
                    else
                    {
                        <span>Impuestos: @item.ImpPlanCompra.Descripcion</span>
                    }
                }
                
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public th_articulos item { get; set; }
}
