@page "/login/usuarios/ver"
@rendermode InteractiveServer
@inject KalanDB DB
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal

<h1>Usuario</h1>


<div class="row">
    <div class="col-12 col-sm-12 col-md-12 col-lg-2 col-xl-2">
        <ReadOnly Etiqueta="Usuario" Value="@_item.UserName"></ReadOnly>
    </div>
</div>
 
<div>
    <a href="/login/usuarios/listado"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
</div>
@code {
    private aspnetusers _item { get; set; }
    [SupplyParameterFromQuery]
    public string Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        _item = DB.aspnetusers.First(m => m.Id == Id);

        if (_item is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

}
