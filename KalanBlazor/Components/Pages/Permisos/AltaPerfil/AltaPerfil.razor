@page "/AltaPerfil"
@using static KalanBlazor.BL.Permisos.AltaPerfil.InsertarPerfil
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject LoadingService LoadingService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<Contenido Titulo="Alta Perfil">

    @* Seccion para seleccionar el nombre que se le asignara el perfil *@
    <Rows>
        <Cols Col="12">
            <label style="margin-top: 10px; font-weight: bold;">Nombre del Perfil <br /></label>
            <Texto Etiqueta="Ingrese el nombre del perfil" @bind-Value="Name" />
        </Cols>
    </Rows>

    @* Seccion para seleccionar el nombre que se le asignara el perfil *@
    <Rows>
        <Cols Col="12">
            <label style="margin-top: 10px; font-weight: bold;">Correo Electrónico del Usuario <br /></label>
            <Texto Etiqueta="Ingrese el correo electrónico" @bind-Value="UsuarioCreacion" />
        </Cols>
    </Rows>

    @* Botones para guardar o cancelar el añadir un nuevo perfil *@
    <Rows>
        <Cols Col="6">
            <button class="btn btn-primary" @onclick="GuardarPerfil">Guardar</button>
        </Cols>
        <Cols Col="6">
            <button class="btn btn-primary" @onclick="RegresarAPermisos">Cancelar</button>
        </Cols>
    </Rows>

    @* Seccion para mostrar el mensaje de exito o error al guardar el perfil *@
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="@estiloMensaje" style="margin-top: 15px;">@mensaje</div>
    }
</Contenido>


@* Modal para mostrar que se guardo con exito el perfil *@
<Modal @ref="modalExitoRef" Title="Éxito">
    <ChildContent>

        <Rows>
            <Cols Col="6">
                El perfil se guardó correctamente.
            </Cols>
        </Rows>
        <Rows>
            <Cols Col="6">
                <button type="button" class="btn btn-success" @onclick="RedirigirAPermisos">OK</button>
            </Cols>
        </Rows>
    </ChildContent>
</Modal>


@code {
    #region Variables para mandar al backend y los errores o exitos
    private string Name = "";
    private string UsuarioCreacion = "";
    private string mensaje = "";
    private string estiloMensaje = "";


    #endregion

    #region Variables para el modal
    //Varibales de los modales

    private bool mostrarModalExito = false;
    private Modal modalExitoRef;

    #endregion


    //Metodo para retornar a la pagina de permisos
    void RegresarAPermisos()
    {
        Navigation.NavigateTo("/Permisos");
    }

    // Metodo para redirigir a la pagina de permisos esperando unos segundos
    private async Task RedirigirAPermisos()
    {
        if (modalExitoRef != null)
        {
            await modalExitoRef.HideModal();
            await Task.Delay(100); // Pequeña demora (en milisegundos)
        }
        Navigation.NavigateTo("/Permisos");
    }


    //Metodo para mostrar el modal de exito
    private async Task MostrarModalExito()
    {
        mostrarModalExito = true;
        await InvokeAsync(StateHasChanged);
        if (modalExitoRef != null)
        {
            await modalExitoRef.ShowModal();
        }
    }

    //Metodo para ocultar el modal de exito
    private async Task OcultarModalExito()
    {
        mostrarModalExito = false;
        await InvokeAsync(StateHasChanged);
        if (modalExitoRef != null)
        {
            await modalExitoRef.HideModal();
        }
    }

    //Metodo para guardar el perfil masndando los datos al backend
    async Task GuardarPerfil()
    {
        try
        {
            string cadenaConexion = Configuration.GetConnectionString("DefaultConnection");
            BL.Permisos.AltaPerfil.InsertarPerfil.Insertar(cadenaConexion, Name, UsuarioCreacion);
            await MostrarModalExito();
        }
        catch (Exception ex)
        {
            mensaje = "❌ Error al guardar el perfil: " + ex.Message;
            estiloMensaje = "text-danger";
        }
    }
}
