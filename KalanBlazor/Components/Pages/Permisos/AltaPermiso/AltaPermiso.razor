    /// Metodo para separar las palabras de la pantalla y ponerle un espacio
    /// </summary>
    private string Separarpalabras(string texto)
    {
        return System.Text.RegularExpressions.Regex.Replace(
            texto,
            "(\\B[A-Z])",
            " $1"
        );
    }


