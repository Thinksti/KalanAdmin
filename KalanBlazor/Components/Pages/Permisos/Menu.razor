@page "/Permisos/Menu"
@inject IConfiguration Configuration
@rendermode InteractiveServer
@inject NavigationManager NavigationManager



<Contenido Titulo="Permisos">

    <Rows>
        @* CARD ALTA PERFIL *@
        <Cols Col="3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Alta Perfil</h5>
                    <table>
                        <tr>
                            <td>Resgistrar Nuevo Perfil </td>
                        </tr>
                        <tr>
                            <td>
                               @*  <button class="btn btn-primary" @onclick="IrACrearPerfil"><i class="fa-solid fa-plus" style="color: white; margin-right: 10px;"></i> Crear nuevo registro</button> *@
                                <a class="btn btn-primary" href="/Permisos/AltaPerfil">
                                    <i class="fa-solid fa-plus" style="color: white; margin-right: 10px;"></i>
                                    Crear nuevo registro
                                </a>
                            </td>
                        </tr>
                    </table>

                </div>
            </div>
        </Cols>
        

        @* CARD GESTION DE PERFILES *@
        <Cols Col="3">
            <div class="card">
