@page "/th_clientes/details"
@inject KalanDB DB

@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore

<PageTitle>Details</PageTitle>

<h1>Detalles</h1>

<div>
    <h4>Clientes</h4>
    <hr />
    @if (th_clientes is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">NombreCorto</dt>
            <dd class="col-sm-10">@th_clientes.NombreCorto</dd>
            <dt class="col-sm-2">RazonSocial</dt>
            <dd class="col-sm-10">@th_clientes.RazonSocial</dd>
            <dt class="col-sm-2">RFC</dt>
            <dd class="col-sm-10">@th_clientes.RFC</dd>
            <dt class="col-sm-2">CodigoPostal</dt>
            <dd class="col-sm-10">@th_clientes.CodigoPostal</dd>
            <dt class="col-sm-2">Direccion</dt>
            <dd class="col-sm-10">@th_clientes.Direccion</dd>
            <div class="mb-3">
                <Texto disabled Etiqueta="Residencia Fiscal(país)" MaxLength="5" @bind-Value="th_clientes.ResidenciaFiscal"></Texto>
            </div>
            <div class="mb-3">
                <Texto disabled Etiqueta="Municipio" MaxLength="100" @bind-Value="th_clientes.Municipio"></Texto>
            </div>
            <div class="mb-3">
                <Texto disabled Etiqueta="Estado" MaxLength="100" @bind-Value="th_clientes.Estado"></Texto>
            </div>
            <div class="mb-3">
                <Texto disabled Etiqueta="Registro Id Tributario(solo extranjeros)" MaxLength="20" @bind-Value="th_clientes.NumRegIdTrib"></Texto>
            </div>
            <dt class="col-sm-2">regimenfiscal_Id</dt>
            <dd class="col-sm-10">@th_clientes.regimenfiscal_Id</dd>
            <dt class="col-sm-2">usocfdi_Id</dt>
            <dd class="col-sm-10">@th_clientes.usocfdi_Id</dd>
            <dd class="col-sm-10">
                <CuentaContable Disabled="true" Etiqueta="Cuenta Contable Proveedor" @bind-Value="th_clientes.cuentacontable_id"></CuentaContable>
            </dd>
            <dt class="col-sm-2">Activo</dt>
            <dd class="col-sm-10">@th_clientes.Activo</dd>
            <dt class="col-sm-2">UsuarioCreacion</dt>
            <dd class="col-sm-10">@th_clientes.UsuarioCreacion</dd>
            <dt class="col-sm-2">FechaCreacion</dt>
            <dd class="col-sm-10">@th_clientes.FechaCreacion</dd>
            <dt class="col-sm-2">UsuarioModifica</dt>
            <dd class="col-sm-10">@th_clientes.UsuarioModifica</dd>
            <dt class="col-sm-2">FechaModifica</dt>
            <dd class="col-sm-10">@th_clientes.FechaModifica</dd>
        </dl>
        <div>
            <a href="@($"/th_clientes/edit?id={th_clientes.Id}")"><i class="fa-solid fa-pen-to-square"></i> Editar</a> |
            <a href="@($"/th_clientes")"><i class="fa-solid fa-arrow-left"></i> Regresar al Index</a>
        </div>
    }
</div>

@code {
    th_clientes? th_clientes;

    [SupplyParameterFromQuery]
    public string Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        th_clientes = await DB.th_clientes.FirstOrDefaultAsync(m => m.Id == Id);

        if (th_clientes is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
