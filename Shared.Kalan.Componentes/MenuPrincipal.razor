<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-sm-3 col-md-2 col-lg-3 col-xl-2">
            @if (@Menus != null)
            {
                <Shared.Kalan.Componentes.MenuIzquierdo NombreCorto="@NombreCorto" ItemsMenu="@Menus" URLLogo="@URLLogo">

                </Shared.Kalan.Componentes.MenuIzquierdo>
            }

        </div>
        <div class="col-12 col-sm-12 col-md-12 col-lg-9 col-xl-10">
            <div class="row">
                <div class="col-12">
                    <MenuSuperior Usuario="@Usuario" URLConfiguracionUsuario=@URLConfiguracionUsuario></MenuSuperior>
                    <div class="container-fluid contenidoBody">
                        @Body
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<ItemMenu> Menus { get; set; }
    [Parameter] public string Usuario { get; set; }
    [Parameter] public string URLLogo { get; set; }
    [Parameter] public string NombreCorto { get; set; }
    [Parameter] public string URLConfiguracionUsuario { get; set; }
    [Parameter] public RenderFragment Body { get; set; }
}
