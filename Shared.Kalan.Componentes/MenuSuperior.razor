@inject NavigationManager NavigationManager
<nav class="navbar navbar-expand-lg bg-body-tertiary navSuperior">
    <div class="container-fluid">
        Bienvenido !!
        <div style="text-align:right;">
            <button @onclick="@(()=>NavigationManager.NavigateTo(URLConfiguracionUsuario))" class="btn btn-link">
                <i class="fa-regular fa-user icon-active-menu"></i><span style="vertical-align:super; padding-left:5px; padding:5px;">@Usuario</span>
            </button>
        </div>
    </div>
</nav>

@code {
    [Parameter] public string Usuario { get; set; }
    [Parameter] public string URLConfiguracionUsuario { get; set; }
}
